{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "oxc", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "unicorn/consistent-function-scoping": "off"
  },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
